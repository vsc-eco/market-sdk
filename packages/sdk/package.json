{
  "name": "@vsc.eco/market-sdk",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Magi (VSC) NFT-marketplace SDK — indexed/state reads, broadcast orchestrator with chunked-batch + cross-contract flows, deployer client",
  "keywords": [
    "hive",
    "vsc",
    "magi",
    "nft",
    "marketplace",
    "auction",
    "indexer"
  ],
  "homepage": "https://github.com/vsc-eco/market-sdk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsc-eco/market-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vsc.eco/market-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
